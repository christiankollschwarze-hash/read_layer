   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Wir müssen reden“",
   "t0": 0.08,
   "t1": 0.923,
   "lang": "de"
  },
  {
   "id": "c002_00088_dl__0",
   "tag": "c002_00088_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Das kann kein Zufall sein.“",
   "t0": 0.001,
   "t1": 1.453,
   "lang": "de"
  },
  {
   "id": "c002_00094_dl__0",
   "tag": "c002_00094_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Bitte. Eine Stunde.“",
   "t0": 0.0,
   "t1": 1.511,
   "lang": "de"
  },
  {
   "id": "c002_00096_dl__0",
   "tag": "c002_00096_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Ich heiße Katharina. Katharina von Tiefenbach.“",
   "t0": 0.0,
   "t1": 2.748,
   "lang": "de"
  },
  {
   "id": "c002_00104_dl__0",
   "tag": "c002_00104_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Cindy. Weißt du, was wir sind?“",
   "t0": 0.021,
   "t1": 2.137,
   "lang": "de"
  },
  {
   "id": "c003_00019_dl__0",
   "tag": "c003_00019_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Welcher Tag?“",
   "t0": 0.001,
   "t1": 0.628,
   "lang": "de"
  },
  {
   "id": "c003_00036_dl__0",
   "tag": "c003_00036_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Ein Baby lässt sich gut vermitteln.“",
   "t0": 0.041,
   "t1": 1.639,
   "lang": "de"
  },
  {
   "id": "c003_00038_dl__0",
   "tag": "c003_00038_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Zwei sind Arbeit.",
   "t0": 0.0,
   "t1": 1.028,
   "lang": "de"
  },
  {
   "id": "c003_00039_s__0",
   "tag": "c003_00039_s",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Also hat jemand eins genommen und eins liegen lassen.“",
   "t0": 0.04,
   "t1": 2.289,
   "lang": "de"
  },
  {
   "id": "c003_00052_dl__0",
   "tag": "c003_00052_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„In allem, wo es Regeln gibt.“",
   "t0": 0.021,
   "t1": 1.333,
   "lang": "de"
  },
  {
   "id": "c003_00057_dl__0",
   "tag": "c003_00057_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Ich habe gestammelt.“",
   "t0": 0.0,
   "t1": 1.03,
   "lang": "de"
  },
  {
   "id": "c003_00065_dl__0",
   "tag": "c003_00065_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Du hattest einen Privatlehrer.",
   "t0": 0.041,
   "t1": 1.577,
   "lang": "de"
  },
  {
   "id": "c003_00066_s__0",
   "tag": "c003_00066_s",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Für die Bewerbung.“",
   "t0": 0.061,
   "t1": 1.091,
   "lang": "de"
  },
  {
   "id": "c003_00078_dl__0",
   "tag": "c003_00078_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Schaukel“",
   "t0": 0.02,
   "t1": 0.541,
   "lang": "de"
  },
  {
   "id": "c003_00079_dl__0",
   "tag": "c003_00079_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Mit sieben.",
   "t0": 0.0,
   "t1": 0.509,
   "lang": "de"
  },
  {
   "id": "c003_00080_s__0",
   "tag": "c003_00080_s",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Die Familie damals fand den Arzt zu teuer.“",
   "t0": 0.001,
   "t1": 2.016,
   "lang": "de"
  },
  {
   "id": "c003_00094_dl__0",
   "tag": "c003_00094_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Ich würde viel für deinen Käfig geben“",
   "t0": 0.0,
   "t1": 1.963,
   "lang": "de"
  },
  {
   "id": "c003_00102_dl__0",
   "tag": "c003_00102_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Was?“",
   "t0": 0.0,
   "t1": 0.352,
   "lang": "de"
  },
  {
   "id": "c003_00110_dl__0",
   "tag": "c003_00110_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Du bist verrückt.“",
   "t0": 0.021,
   "t1": 0.845,
   "lang": "de"
  },
  {
   "id": "c003_00114_dl__0",
   "tag": "c003_00114_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Lass mich nachdenken“",
   "t0": 0.041,
   "t1": 1.005,
   "lang": "de"
  },
  {
   "id": "c004_00020_s__1",
   "tag": "c004_00020_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Die trage ich jetzt jeden Tag.",
   "t0": 2.091,
   "t1": 3.478,
   "lang": "de"
  },
  {
   "id": "c004_00021_s__0",
   "tag": "c004_00021_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Auch bei dir.",
   "t0": 0.021,
   "t1": 0.669,
   "lang": "de"
  },
  {
   "id": "c004_00022_s__0",
   "tag": "c004_00022_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Damit ich nicht vergesse, wer ich bin.“",
   "t0": 0.021,
   "t1": 1.775,
   "lang": "de"
  },
  {
   "id": "c004_00038_dl__0",
   "tag": "c004_00038_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Ich schaff das.“",
   "t0": 0.061,
   "t1": 0.667,
   "lang": "de"
  },
  {
   "id": "c004_00043_s__0",
   "tag": "c004_00043_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Wenn er komisch wird, geh einfach.",
   "t0": 0.323,
   "t1": 2.439,
   "lang": "de"
  },
  {
   "id": "c004_00044_s__0",
   "tag": "c004_00044_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Raus aus der Wohnung.",
   "t0": 0.042,
   "t1": 0.979,
   "lang": "de"
  },
  {
   "id": "c004_00045_s__0",
   "tag": "c004_00045_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "Ruf mich an.“",
   "t0": 0.041,
   "t1": 0.745,
   "lang": "de"
  },
  {
   "id": "c004_00046_dl__0",
   "tag": "c004_00046_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Cindy.“",
   "t0": 0.021,
   "t1": 0.543,
   "lang": "de"
  },
  {
   "id": "c004_00047_s__0",
   "tag": "c004_00047_s",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Es ist eine Woche.“",
   "t0": 0.041,
   "t1": 1.147,
   "lang": "de"
  },
  {
   "id": "c004_00056_dl__0",
   "tag": "c004_00056_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "kopie",
   "text": "„Eine Woche.“",
   "t0": 0.041,
   "t1": 0.585,
   "lang": "de"
  },
  {
   "id": "c005_00015_dl__0",
   "tag": "c005_00015_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Wo warst du?“",
   "t0": 0.0,
   "t1": 0.528,
   "lang": "de"
  },
  {
   "id": "c005_00022_dl__0",
   "tag": "c005_00022_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Mach was zu essen.“",
   "t0": 0.022,
   "t1": 0.86,
   "lang": "de"
  },
  {
   "id": "c005_00091_dl__0",
   "tag": "c005_00091_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Du bist komisch geworden“",
   "t0": 0.02,
   "t1": 1.345,
   "lang": "de"
  },
  {
   "id": "c005_00092_dl__0",
   "tag": "c005_00092_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„So still. So… fein.“",
   "t0": 0.02,
   "t1": 2.885,
   "lang": "de"
  },
  {
   "id": "c005_00096_dl__0",
   "tag": "c005_00096_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Müde.“",
   "t0": 0.0,
   "t1": 0.444,
   "lang": "de"
  },
  {
   "id": "c005_00098_dl__0",
   "tag": "c005_00098_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Wovon denn?“",
   "t0": 0.001,
   "t1": 0.726,
   "lang": "de"
  },
  {
   "id": "c005_00100_dl__0",
   "tag": "c005_00100_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Bist jetzt siebzehn. Erwachsen.“",
   "t0": 0.0,
   "t1": 2.602,
   "lang": "de"
  },
  {
   "id": "c005_00105_dl__0",
   "tag": "c005_00105_dl",
   "figur": "Torben Mehring",
   "stimme": "voice_axuapv2e9fp7",
   "modus": "gemini",
   "text": "„Hab ich gesagt, dass du gehen kannst?“",
   "t0": 0.0,
   "t1": 1.424,
   "lang": "de"
  },
  {
   "id": "c005_00133_dl__0",
   "tag": "c005_00133_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Cindy“",
   "t0": 0.02,
   "t1": 0.583,
   "lang": "de"
  },
  {
   "id": "c005_00134_dl__0",
   "tag": "c005_00134_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Jetzt reden wir mal.“",
   "t0": 0.021,
   "t1": 1.693,
   "lang": "de"
  },
  {
   "id": "c006_00094_dl__0",
   "tag": "c006_00094_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Du bist weg“",
   "t0": 0.001,
   "t1": 0.627,
   "lang": "de"
  },
  {
   "id": "c006_00095_dl__0",
   "tag": "c006_00095_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Du bist abgehauen.“",
   "t0": 0.0,
   "t1": 0.852,
   "lang": "de"
  },
  {
   "id": "c006_00099_dl__0",
   "tag": "c006_00099_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Nichts.“",
   "t0": 0.02,
   "t1": 0.522,
   "lang": "de"
  },
  {
   "id": "c006_00100_dl__0",
   "tag": "c006_00100_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Es gibt keine zwei. Es gibt nur dich. Und du bist weg.“",
   "t0": 0.0,
   "t1": 3.048,
   "lang": "de"
  },
  {
   "id": "c006_00108_dl__0",
   "tag": "c006_00108_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Raus“",
   "t0": 0.061,
   "t1": 0.524,
   "lang": "de"
  },
  {
   "id": "c006_00109_dl__0",
   "tag": "c006_00109_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Du wohnst hier nicht mehr. Du warst nie hier.“",
   "t0": 0.02,
   "t1": 2.068,
   "lang": "de"
  },
  {
   "id": "c007_00014_dl__0",
   "tag": "c007_00014_dl",
   "figur": "Professor Schneider",
   "stimme": "voice_b75g4m1lqewz",
   "modus": "gemini",
   "text": "„Anders“,",
   "t0": 0.0,
   "t1": 0.483,
   "lang": "de"
  },
  {
   "id": "c007_00015_dl__0",
   "tag": "c007_00015_dl",
   "figur": "Professor Schneider",
   "stimme": "voice_b75g4m1lqewz",
   "modus": "gemini",
   "text": "„Technisch schwächer.",
   "t0": 0.001,
   "t1": 0.907,
   "lang": "de"
  },
  {
   "id": "c007_00016_dl__0",
   "tag": "c007_00016_dl",
   "figur": "Professor Schneider",
   "stimme": "voice_b75g4m1lqewz",
   "modus": "gemini",
   "text": "Aber da ist etwas Neues.",
   "t0": 0.041,
   "t1": 1.275,
   "lang": "de"
  },
  {
   "id": "c007_00017_dl__0",
   "tag": "c007_00017_dl",
   "figur": "Professor Schneider",
   "stimme": "voice_b75g4m1lqewz",
   "modus": "gemini",
   "text": "Als würdest du mit dem Instrument etwas verarbeiten.“",
   "t0": 0.02,
   "t1": 2.774,
   "lang": "de"
  },
  {
   "id": "c007_00055_s__0",
   "tag": "c007_00055_s",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "wer bist du",
   "t0": 0.043,
   "t1": 0.634,
   "lang": "de"
  },
  {
   "id": "c007_00062_s__1",
   "tag": "c007_00062_s",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Ich kann nicht mehr schlafen.",
   "t0": 2.515,
   "t1": 3.662,
   "lang": "de"
  },
  {
   "id": "c007_00063_s__0",
   "tag": "c007_00063_s",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Die Toten lassen mich nicht.",
   "t0": 0.0,
   "t1": 1.346,
   "lang": "de"
  },
  {
   "id": "c008_00046_dl__0",
   "tag": "c008_00046_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ja.“",
   "t0": 0.025,
   "t1": 0.23,
   "lang": "de"
  },
  {
   "id": "c008_00057_dl__0",
   "tag": "c008_00057_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Das ist meine.",
   "t0": 0.002,
   "t1": 0.74,
   "lang": "de"
  },
  {
   "id": "c008_00058_dl__0",
   "tag": "c008_00058_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Ich habe sie verloren.“",
   "t0": 0.001,
   "t1": 0.895,
   "lang": "de"
  },
  {
   "id": "c008_00062_dl__0",
   "tag": "c008_00062_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Im Sommer.",
   "t0": 0.0,
   "t1": 0.564,
   "lang": "de"
  },
  {
   "id": "c008_00063_dl__0",
   "tag": "c008_00063_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Irgendwann im August, glaube ich.",
   "t0": 0.041,
   "t1": 1.453,
   "lang": "de"
  },
  {
   "id": "c008_00064_dl__0",
   "tag": "c008_00064_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Beim Joggen an der Elbe.“",
   "t0": 0.0,
   "t1": 1.175,
   "lang": "de"
  },
  {
   "id": "c008_00070_dl__0",
   "tag": "c008_00070_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Deshalb habe ich nichts gesagt, Mama.",
   "t0": 0.0,
   "t1": 1.527,
   "lang": "de"
  },
  {
   "id": "c008_00071_dl__0",
   "tag": "c008_00071_dl",
   "figur": "Katharina von Tiefenbach",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Es war mir peinlich.“",
   "t0": 0.021,
   "t1": 0.997,
   "lang": "de"
  },
  {
   "id": "c009_00094_dl__0",
   "tag": "c009_00094_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Die ist weg.“",
   "t0": 0.0,
   "t1": 0.513,
   "lang": "de"
  },
  {
   "id": "c009_00106_dl__0",
   "tag": "c009_00106_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Sie kommt jede Nacht“,",
   "t0": 0.242,
   "t1": 1.367,
   "lang": "de"
  },
  {
   "id": "c009_00108_dl__0",
   "tag": "c009_00108_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Sie ruft an.",
   "t0": 0.001,
   "t1": 0.629,
   "lang": "de"
  },
  {
   "id": "c009_00109_dl__0",
   "tag": "c009_00109_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Sie schreibt.",
   "t0": 0.001,
   "t1": 0.694,
   "lang": "de"
  },
  {
   "id": "c009_00110_dl__0",
   "tag": "c009_00110_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Ich hab sie an der Kneipe gesehen.",
   "t0": 0.021,
   "t1": 1.458,
   "lang": "de"
  },
  {
   "id": "c009_00111_dl__0",
   "tag": "c009_00111_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Sie hat mir das da aufs Kopfkissen gelegt.“",
   "t0": 0.0,
   "t1": 2.129,
   "lang": "de"
  },
  {
   "id": "c009_00113_dl__0",
   "tag": "c009_00113_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Ich hab sie doch… Ich hab sie doch weggebracht.",
   "t0": 0.0,
   "t1": 2.879,
   "lang": "de"
  },
  {
   "id": "c009_00114_dl__0",
   "tag": "c009_00114_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Und sie kommt trotzdem.“",
   "t0": 0.001,
   "t1": 1.211,
   "lang": "de"
  },
  {
   "id": "c009_00127_dl__0",
   "tag": "c009_00127_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Sie war anders in der Nacht“,",
   "t0": 0.241,
   "t1": 1.987,
   "lang": "de"
  },
  {
   "id": "c009_00129_dl__0",
   "tag": "c009_00129_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Cindy hat nie geschrien.",
   "t0": 0.04,
   "t1": 1.664,
   "lang": "de"
  },
  {
   "id": "c009_00130_dl__0",
   "tag": "c009_00130_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Die hat geschrien.",
   "t0": 0.041,
   "t1": 1.092,
   "lang": "de"
  },
  {
   "id": "c009_00131_dl__0",
   "tag": "c009_00131_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Die hat sich gewehrt.",
   "t0": 0.001,
   "t1": 0.913,
   "lang": "de"
  },
  {
   "id": "c009_00132_dl__0",
   "tag": "c009_00132_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Ich wollte nur, dass sie still ist.“",
   "t0": 0.021,
   "t1": 1.372,
   "lang": "de"
  },
  {
   "id": "c009_00148_dl__0",
   "tag": "c009_00148_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Die, die jetzt kommt“,",
   "t0": 0.02,
   "t1": 1.325,
   "lang": "de"
  },
  {
   "id": "c009_00149_dl__0",
   "tag": "c009_00149_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "„Die ist es doch auch nicht, oder?",
   "t0": 0.021,
   "t1": 1.53,
   "lang": "de"
  },
  {
   "id": "c009_00150_dl__0",
   "tag": "c009_00150_dl",
   "figur": "Werner Koslowski",
   "stimme": "voice_kp6y1izwehd9",
   "modus": "gemini",
   "text": "Die ist auch nicht Cindy.“",
   "t0": 0.0,
   "t1": 1.167,
   "lang": "de"
  },
  {
   "id": "c010_00029_dl__0",
   "tag": "c010_00029_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Cindy“",
   "t0": 0.041,
   "t1": 0.464,
   "lang": "de"
  },
  {
   "id": "c010_00030_dl__0",
   "tag": "c010_00030_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Cindy Bergmann.“",
   "t0": 0.041,
   "t1": 0.908,
   "lang": "de"
  },
  {
   "id": "c010_00038_dl__0",
   "tag": "c010_00038_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Eine Woche“",
   "t0": 0.041,
   "t1": 0.605,
   "lang": "de"
  },
  {
   "id": "c010_00039_dl__0",
   "tag": "c010_00039_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Wir wollten am 4. September zurücktauschen.",
   "t0": 0.0,
   "t1": 2.232,
   "lang": "de"
  },
  {
   "id": "c010_00040_dl__0",
   "tag": "c010_00040_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Am Hauptbahnhof, beim Bäcker.“",
   "t0": 0.021,
   "t1": 1.622,
   "lang": "de"
  },
  {
   "id": "c010_00046_dl__0",
   "tag": "c010_00046_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Den hatte sie immer dabei.",
   "t0": 0.0,
   "t1": 1.39,
   "lang": "de"
  },
  {
   "id": "c010_00047_dl__0",
   "tag": "c010_00047_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Immer.",
   "t0": 0.044,
   "t1": 0.329,
   "lang": "de"
  },
  {
   "id": "c010_00048_dl__0",
   "tag": "c010_00048_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Er lag unter dem Regal.“",
   "t0": 0.021,
   "t1": 1.116,
   "lang": "de"
  },
  {
   "id": "c010_00054_dl__0",
   "tag": "c010_00054_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Mit was?",
   "t0": 0.0,
   "t1": 0.522,
   "lang": "de"
  },
  {
   "id": "c010_00055_dl__0",
   "tag": "c010_00055_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Mit einem EpiPen und einem nassen Fußboden?",
   "t0": 0.04,
   "t1": 2.726,
   "lang": "de"
  },
  {
   "id": "c010_00056_dl__0",
   "tag": "c010_00056_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Ich, ein Mädchen aus Steilshoop, das in einer fremden Villa wohnt und sagt, die Tochter des Hauses ist tot?",
   "t0": 0.02,
   "t1": 5.587,
   "lang": "de"
  },
  {
   "id": "c010_00057_dl__0",
   "tag": "c010_00057_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Sie hätten mich zurückgeschickt.",
   "t0": 0.021,
   "t1": 1.252,
   "lang": "de"
  },
  {
   "id": "c010_00058_dl__0",
   "tag": "c010_00058_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Und er hätte gesagt, ich spinne.",
   "t0": 0.02,
   "t1": 1.745,
   "lang": "de"
  },
  {
   "id": "c010_00059_dl__0",
   "tag": "c010_00059_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Das hat er früher auch immer gesagt.“",
   "t0": 0.0,
   "t1": 1.467,
   "lang": "de"
  },
  {
   "id": "c010_00062_dl__0",
   "tag": "c010_00062_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ich habe ihr nicht erzählt, was er nachts macht.",
   "t0": 0.0,
   "t1": 1.99,
   "lang": "de"
  },
  {
   "id": "c010_00063_dl__0",
   "tag": "c010_00063_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Ich habe gesagt, er ist betrunken und berechenbar.",
   "t0": 0.02,
   "t1": 2.473,
   "lang": "de"
  },
  {
   "id": "c010_00064_dl__0",
   "tag": "c010_00064_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Ich wollte diese Woche haben.“",
   "t0": 0.021,
   "t1": 1.341,
   "lang": "de"
  },
  {
   "id": "c010_00066_dl__0",
   "tag": "c010_00066_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ich habe sie hingeschickt.",
   "t0": 0.02,
   "t1": 1.005,
   "lang": "de"
  },
  {
   "id": "c010_00067_dl__0",
   "tag": "c010_00067_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Er hat sie umgebracht, aber ich habe sie hingeschickt.“",
   "t0": 0.041,
   "t1": 2.877,
   "lang": "de"
  },
  {
   "id": "c010_00074_dl__0",
   "tag": "c010_00074_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ja.“",
   "t0": 0.003,
   "t1": 0.248,
   "lang": "de"
  },
  {
   "id": "c010_00077_dl__0",
   "tag": "c010_00077_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Gut.“",
   "t0": 0.023,
   "t1": 0.391,
   "lang": "de"
  },
  {
   "id": "c010_00080_dl__0",
   "tag": "c010_00080_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ich habe ihn nicht angefasst.",
   "t0": 0.0,
   "t1": 1.36,
   "lang": "de"
  },
  {
   "id": "c010_00081_dl__0",
   "tag": "c010_00081_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "Ich habe ihm nur gesagt, was er getan hat.",
   "t0": 0.0,
   "t1": 1.999,
   "lang": "de"
  },
  {
   "id": "c011_00048_dl__0",
   "tag": "c011_00048_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Herr Mehring.“",
   "t0": 0.022,
   "t1": 0.555,
   "lang": "de"
  },
  {
   "id": "c011_00050_dl__1",
   "tag": "c011_00050_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Danke.“",
   "t0": 1.531,
   "t1": 1.953,
   "lang": "de"
  },
  {
   "id": "c011_00052_dl__0",
   "tag": "c011_00052_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ich weiß.“",
   "t0": 0.02,
   "t1": 0.52,
   "lang": "de"
  },
  {
   "id": "c011_00052_dl__2",
   "tag": "c011_00052_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Ich trage schon eine ganze Menge mit mir herum. Eins mehr fällt nicht auf.“",
   "t0": 3.642,
   "t1": 7.505,
   "lang": "de"
  },
  {
   "id": "c011_00056_dl__0",
   "tag": "c011_00056_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Warum haben Sie das gemacht?“,",
   "t0": 0.0,
   "t1": 1.106,
   "lang": "de"
  },
  {
   "id": "c011_00056_dl__2",
   "tag": "c011_00056_dl",
   "figur": "Cindy Bergmann",
   "stimme": "Zephyr",
   "modus": "gemini",
   "text": "„Mit der Staatsanwältin.“",
   "t0": 2.617,
   "t1": 3.622,
   "lang": "de"
  },
  {
   "id": "c012_00033_dl__0",
   "tag": "c012_00033_dl",
   "figur": "Schulleiterin",
   "stimme": "voice_zhw7793d33tq",
   "modus": "gemini",
   "text": "„Das nächste Stück war Katharina von Tiefenbach zugedacht“",
   "t0": 0.0,
   "t1": 2.967,
   "lang": "de"
  },
  {
   "id": "c012_00034_dl__0",
   "tag": "c012_00034_dl",
   "figur": "Schulleiterin",
   "stimme": "voice_zhw7793d33tq",
   "modus": "gemini",
   "text": "„Es spielt ihre Schwester.",
   "t0": 0.0,
   "t1": 1.051,
   "lang": "de"
  },
  {
   "id": "c012_00035_dl__0",
   "tag": "c012_00035_dl",
   "figur": "Schulleiterin",
   "stimme": "voice_zhw7793d33tq",
   "modus": "gemini",
   "text": "Cindy Bergmann.“",
   "t0": 0.022,
   "t1": 0.92,
   "lang": "de"
  }
 ]
}